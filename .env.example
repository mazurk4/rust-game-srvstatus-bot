DISCORD_TOKEN=your_discord_bot_token
CHANNEL_ID=123456789012345678

RUST_SERVER_HOST=127.0.0.1
RUST_SERVER_PORT=28017

# 人数・定員・Queue / Joining の取得に使用（Rust WebRCON）
RCON_HOST=127.0.0.1
RCON_PORT=28016
RCON_PASSWORD=your_secure_rcon_password
RCON_TIMEOUT=3

UPDATE_INTERVAL=30

# RustDedicated 起動後この秒数以内は「起動中」と表示（マップ生成が長い場合は延ばす）
STARTING_DURATION=300
